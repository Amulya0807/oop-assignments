#include<iostream>
using namespace std;
class person
{
  public:
  string name;
  int age;
  long contact;
  void display()
  {
    cout<<"-------Person Details------"<<endl;
    cout<<"NAME:"<<name<<endl;
    cout<<"AGE:"<<age<<endl;
    cout<<"CONTACT:"<<contact<<endl;
  }
};
class student:public person
{
  public:
  int rollno;
  string branch;
  void showdata()
  {
    cout<<"------Data Showcased------"<<endl;
    cout<<"ROLLNO:"<<rollno<<endl;
    cout<<"BRANCH:<<branch<<endl;
  }
};
int main()
{
student s1;
s1.name="Shinchan";
s1.age=21;
s1.contact=9087654567;
s1.rollno=23;
s1.branch="AIML";
s1.display();
s1.showdata();
return 0;
}
