#include <iostream>
using namespace std;

template <class T>
T findLarger(T a, T b)
{
    if (a > b)
        return a;
    else
        return b;
}

int main()
{
    cout << "Larger number: " << findLarger(10, 20) << endl;
    cout << "Larger marks: " << findLarger(85.5, 90.5) << endl;
    cout << "Larger price: " << findLarger(150, 200) << endl;

    return 0;
}
