#include <iostream>
using namespace std;

template <class T>
void swapValue(T &a, T &b)
{
    T c= a;
    a = b;
    b = c;
}

int main()
{
    int x = 10, y = 20;
    float p = 2.5, q = 5.5;

    cout << "Before swapping:" << endl;
    cout << "x = " << x << " y = " << y << endl;
    cout << "p = " << p << " q = " << q << endl;

    swapValue(x, y);
    swapValue(p, q);

    cout << "\nAfter swapping:" << endl;
    cout << "x = " << x << " y = " << y << endl;
    cout << "p = " << p << " q = " << q << endl;

    return 0;
}
