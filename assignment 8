#include <iostream>
using namespace std;

class Person
{
public:
    string name;
    int age;

    void display()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }
};

class Employee : public Person
{
public:
    int empID;
    float salary;

    void show()
    {
        cout << "Employee ID: " << empID << endl;
        cout << "Salary: " << salary << endl;
    }
};

class Manager : public Employee
{
public:
    string department;

    void manage()
    {
        cout << "Department: " << department << endl;
    }
};

int main()
{
    Manager m;

    m.name = "Rahul";
    m.age = 39;
    m.empID = 101;
    m.salary = 50000;
    m.department = "Marketing";

    m.display();
    m.show();
    m.manage();

    return 0;
}
